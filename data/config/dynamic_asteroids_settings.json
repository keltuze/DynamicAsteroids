{
	# =========================================================================
	# ЯЗЫК МЕНЮ / LANGUAGE
	# =========================================================================
	"language": "ru",

	# =========================================================================
	# ПОТОК В АСТЕРОИДНЫХ ПОЛЯХ / ASTEROID FIELD STREAM
	# =========================================================================
	# Минимальное количество астероидов при расчете плотности поля на бой (по умолчанию 70)
	"minFieldRocks": 70,

	# Максимальное количество астероидов при расчете плотности поля на бой (по умолчанию 160)
	# Точное количество выбирается случайно в этом диапазоне 1 раз на весь бой
	"maxFieldRocks": 160,

	# Скорость потока астероидов (ГИПЕРЗВУКОВОЙ ТЕСТ: 3000 ед/сек!)
	"fieldSurgeSpeed": 3000.0,

	# Максимальное время жизни астероида (в секундах). Ровно 30 секунд!
	"asteroidLifespan": 30.0,

	# =========================================================================
	# ОТКРЫТЫЙ КОСМОС (ВНЕ ПОЛЕЙ АСТЕРОИДОВ) / OPEN SPACE
	# =========================================================================
	# Количество редких метеоров в открытом космосе (мин и макс)
	"openSpaceMinRocks": 4,
	"openSpaceMaxRocks": 10,

	# Минимальная и максимальная задержка между спавном в открытом космосе (в секундах)
	# Случайный интервал предотвращает полет камней сплошной стеной
	"openSpaceMinDelay": 1.5,
	"openSpaceMaxDelay": 5.0
}
